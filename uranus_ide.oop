        {
            "item_id": "a4adbb",
            "created_at": "Thursday | 18 June 2026 | 12:24:40",
            "author": "Unknown",
            "item_lock": false,
            "item_type": "Method",
            "title": "find_replace",
            "revision": "1.0",
            "item_tag": "",
            "docstring": "",
            "code": "def find_replace(self):\n        \n        \n    if self.focused_cell :\n        if hasattr(self.focused_cell, \"editor\"): # for Code Editor\n            editor = self.focused_cell.editor\n            dialog = FindReplaceDialog(editor, self)\n            dialog.exec_()\n\n                \n        elif hasattr(self.focused_cell, \"d_editor\"):  # for  DocumentEditor\n            editor = self.focused_cell.d_editor.editor\n            dialog = FindReplaceDialog(editor, self)\n            dialog.exec_()\n",
            "todo_list": [],
            "parent_id": "9fee50",
            "path": "/9fee50/a4adbb",
            "item_suppress": false,
            "item_modifire": "",
            "line": 1268,
