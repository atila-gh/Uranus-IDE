        {
            "item_id": "f0ae6e",
            "created_at": "Saturday | 15 August 2026 | 11:29:34",
            "author": "Unknown",
            "item_lock": false,
            "item_type": "Method",
            "title": "get_color_for_type",
            "revision": "1.0",
            "item_tag": "",
            "docstring": "",
            "code": "def get_color_for_type(self, completion_type):\n    colors = {\n        'module': '#BA68C8',\n        'class': '#FFD54F',\n        'function': '#FFD54F',\n        'method': '#FFD54F',\n        'property': '#81C784',\n        'statement': '#64B5F6',\n        'keyword': '#FF6347',\n        'param': '#9CDCFE',\n        'path': '#CE9178',\n        'builtin': '#FFD54F',\n    }\n    return colors.get(completion_type, '#D4D4D4')\n",
            "todo_list": [],
            "parent_id": "c58d02",
            "path": "/c58d02/f0ae6e",
            "item_suppress": false,
            "item_modifire": "",
            "line": 170,
            "module_id": "4091e6",
            "g_flag": false,
            "r_flag": false,
