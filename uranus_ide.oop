        {
            "item_id": "ee036b",
            "created_at": "Thursday | 18 June 2026 | 12:20:48",
            "author": "Unknown",
            "item_lock": false,
            "item_type": "Method",
            "title": "image_to_base64",
            "revision": "1.0",
            "item_tag": "",
            "docstring": "Converts an image file to a base64 encoded string.",
            "code": "def image_to_base64(self,image_path):\n    try:\n        with open(image_path, \"rb\") as image_file:\n            encoded_string = base64.b64encode(image_file.read()).decode(\"utf-8\")\n        return encoded_string\n    except FileNotFoundError:\n        print(f\"Error: The image file at {image_path} was not found.\")\n    except Exception as e:\n        print(f\"Error while converting image {image_path}: {e}\")\n    return None\n",
