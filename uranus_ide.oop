            "revision": "1.0",
            "item_tag": "",
            "docstring": "",
            "code": "def select_next(self):\n    row = self.list_widget.currentRow()\n    if row < self.list_widget.count() - 1:\n        self.list_widget.setCurrentRow(row + 1)\n    else:\n        self.list_widget.setCurrentRow(0)\n",
