        {
            "item_id": "b07333",
            "created_at": "Thursday | 18 June 2026 | 13:39:12",
            "author": "Unknown",
            "item_lock": false,
            "item_type": "Method",
            "title": "adjust_height_document_editor",
            "revision": "1.0",
            "item_tag": "",
            "docstring": "print('[adjust_height_document_editor]')",
            "code": "def adjust_height_document_editor(self):\n    doc = self.editor.document()\n    layout = doc.documentLayout()\n\n    content_height = layout.documentSize().height()\n            \n    cm = self.editor.contentsMargins()\n    toolbar_height = 30 if self.toolbar.isVisible() else 0\n\n    new_height = int(content_height \n            + toolbar_height \n            + doc.documentMargin()   \n            + self.editor.frameWidth() * 2  \n            + cm.top() \n            + cm.bottom()\n\n\n    self.editor_height = new_height #  New Height to save to file metadata\n        \n    if self.readonly_mode:\n        self.setMinimumHeight(new_height)\n        self.setMaximumHeight(new_height)\n    else:\n        min_height = 100\n        max_height = 800\n        final_height = max(min_height, min(new_height, max_height))\n        self.setMinimumHeight(final_height)\n        self.setMaximumHeight(final_height)\n\n    self.updateGeometry()\n    self.flag_doc_height_adjust = True\n    ",
            "todo_list": [],
            "parent_id": "214e95",
            "path": "/214e95/b07333",
