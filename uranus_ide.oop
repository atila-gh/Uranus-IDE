            "created_at": "Saturday | 15 August 2026 | 10:40:56",
            "author": "Unknown",
            "item_lock": false,
            "item_type": "Entry Point",
            "title": "Module Entry Point",
            "revision": "1.0",
            "item_tag": "",
            "docstring": "",
            "code": "# ==================== Entry Point \u0628\u0631\u0627\u06cc \u062a\u0633\u062a \u0645\u0633\u062a\u0642\u0644 ====================\nif __name__ == \"__main__\":\n    import sys\n    from PyQt5.QtWidgets import QApplication\n    \n    app = QApplication(sys.argv)\n    \n    app.setStyle('Fusion')\n    \n    window = SettingsWindow()\n    window.setWindowTitle(\"Uranus IDE - Settings (Standalone)\")\n    window.show()\n    \n    sys.exit(app.exec_())",
            "todo_list": [],
            "parent_id": "1d81f4",
