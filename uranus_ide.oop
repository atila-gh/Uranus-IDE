            "icon_text": "m"
        },
        {
            "item_id": "604a19",
            "created_at": "Thursday | 18 June 2026 | 12:42:27",
            "author": "Unknown",
            "item_lock": false,
            "item_type": "Method",
            "title": "select_color",
            "revision": "1.0",
            "item_tag": "",
            "docstring": "",
            "code": "\ndef select_color(self, key):\n    color = QColorDialog.getColor()\n    if color.isValid():\n        if  self.settings[\"colors\"].get(key,False):\n            self.settings[\"colors\"][key] = color.name()\n            self.color_previews[key].setStyleSheet(f\"background-color: {color.name()}; border: 1px solid gray;\")\n            \n        elif  self.settings[\"colors_syntax\"].get(key,False):\n            self.settings[\"colors_syntax\"][key] = color.name()\n            self.syntax_color_previews[key].setStyleSheet(f\"background-color: {color.name()}; border: 1px solid gray;\")\n        \n        self.save_settings()\n",
            "todo_list": [],
            "parent_id": "03fbaf",
            "path": "/03fbaf/604a19",
            "item_suppress": false,
            "item_modifire": "",
            "line": 359,
            "module_id": "1d81f4",
