            "code": "def select_previous(self):\n    row = self.list_widget.currentRow()\n    if row > 0:\n        self.list_widget.setCurrentRow(row - 1)\n    else:\n        self.list_widget.setCurrentRow(self.list_widget.count() - 1)\n",
