            "title": "sizeHint",
            "revision": "1.0",
            "item_tag": "",
            "docstring": "\u0639\u0631\u0636 \u0633\u062a\u0648\u0646 \u0628\u0631 \u0627\u0633\u0627\u0633 \u062a\u0639\u062f\u0627\u062f \u0631\u0642\u0645\u200c\u0647\u0627",
            "code": "def sizeHint(self):\n    digits = len(str(max(1, self.editor.blockCount())))\n    fm = self.editor.fontMetrics()\n    return QSize(fm.horizontalAdvance(\"9\" * digits) + 12, 0)\n",
