            "item_type": "Method",
            "title": "set_status_left",
            "revision": "1.0",
            "item_tag": "",
            "docstring": "Update the left section of the status bar.",
            "code": "def set_status_left(self, text: str):\n    self.status_left.setText(text)\n    QTimer.singleShot(3000, lambda: self.status_left.clear())\n",
            "todo_list": [],
