            "revision": "1.0",
            "item_tag": "",
            "docstring": "",
            "code": "def update_line_char_update(self, line, column):\n        self.line_number.setText(f\"Line: {line:^5} | Char: {column:^5}\")\n        self.status_r(f\"Line: {line:^5} | Char: {column:^5}     \")\n",
