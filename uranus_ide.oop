            "revision": "1.0",
            "item_tag": "",
            "docstring": "",
            "code": "def main():\n    \n    app = QApplication(sys.argv)\n    # app.setStyle(\"Fusion\")\n    install_fonts()\n    print(\"\ud83c\udfa8 Available styles:\", QStyleFactory.keys())\n    \n    # For Dark Mode\n    #import qdarktheme\n    #qdarktheme.setup_theme(\"dark\")\n    \n    window = MainWindow()\n    window.show()\n    sys.exit(app.exec_())\n    ",
