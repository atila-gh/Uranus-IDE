        {
            "item_id": "54cf3f",
            "created_at": "Saturday | 15 August 2026 | 11:07:35",
            "author": "Unknown",
            "item_lock": false,
            "item_type": "Method",
            "title": "eventFilter",
            "revision": "1.0",
            "item_tag": "",
            "docstring": "",
            "code": "def eventFilter(self, obj, event):\n    if isinstance(obj, QCheckBox):\n        if event.type() == event.Enter:\n            self.status_bar.showMessage(obj.description)\n        elif event.type() == event.Leave:\n            self.status_bar.clearMessage()\n    return super().eventFilter(obj, event)\n",
            "todo_list": [],
