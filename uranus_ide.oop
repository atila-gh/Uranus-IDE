            "item_type": "Method",
            "title": "show_image_from_base64",
            "revision": "1.0",
            "item_tag": "",
            "docstring": "Loads and displays a base64-encoded PNG image.\nAutomatically adjusts widget height.",
            "code": "def show_image_from_base64(self, base64_data):\n    pixmap = QPixmap()\n    pixmap.loadFromData(base64.b64decode(base64_data))\n    self.image_label.setPixmap(pixmap)\n\n    height = pixmap.height()\n    height = max(height, 150)  \n\n\n    self.image_label.setMinimumHeight(height)\n    self.image_label.setMaximumHeight(height)\n    self.image_label.updateGeometry()\n    self.setVisible(True)\n",
            "todo_list": [],
