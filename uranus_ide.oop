            "item_type": "Method",
            "title": "eventFilter",
            "revision": "1.0",
            "item_tag": "",
            "docstring": "",
            "code": "def eventFilter(self, obj, event):\n        if obj == self and event.type() == QEvent.KeyPress:\n            if event.key() in (Qt.Key_Return, Qt.Key_Enter):\n                self.adjust_height_code()\n        return super().eventFilter(obj, event)\n",
