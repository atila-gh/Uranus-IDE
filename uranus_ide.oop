            "title": "my_copy",
            "revision": "1.0",
            "item_tag": "",
            "docstring": "",
            "code": "def my_copy(self):\n    cursor = self.textCursor()\n    if cursor.hasSelection():\n        selected_text = cursor.selectedText()\n        trimmed_text = selected_text.strip()\n        QApplication.clipboard().setText(trimmed_text)\n    else:\n        super().copy()\n    ",
