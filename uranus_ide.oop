        {
            "item_id": "974596",
            "created_at": "Thursday | 18 June 2026 | 12:15:50",
            "author": "Unknown",
            "item_lock": false,
            "item_type": "Method",
            "title": "wait_for_input",
            "revision": "1.0",
            "item_tag": "",
            "docstring": "",
            "code": "\ndef wait_for_input(self, prompt = None):\n    self._prompt = prompt\n    QMetaObject.invokeMethod(self, \"_show_dialog\", Qt.BlockingQueuedConnection)\n    return self._value\n",
