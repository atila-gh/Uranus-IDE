            "docstring": "",
            "code": "\ndef save_settings(self):\n    path = get_setting_path()\n    try:\n        with open(path, \"w\", encoding=\"utf-8\") as f:\n            json.dump(self.settings, f, indent=4, ensure_ascii=False)\n    except Exception as e:\n        print(f\"\u26a0\ufe0f Failed to save settings: {e}\")\n",
