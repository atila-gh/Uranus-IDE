        {
            "item_id": "50dda6",
            "created_at": "Thursday | 18 June 2026 | 12:00:46",
            "author": "Unknown",
            "item_lock": false,
            "item_type": "Method",
            "title": "print_cell",
            "revision": "1.0",
            "item_tag": "",
            "docstring": "Print the full content of this cell (code/doc editor + outputs),\nbut only if each editor/output is visible.",
            "code": "def print_cell(self, parent=None):\n    printer = QPrinter(QPrinter.HighResolution)\n    dialog = QPrintDialog(printer, parent or self)\n    if dialog.exec_() != QPrintDialog.Accepted:\n        return\n\n    doc = QTextDocument()\n    cursor = QTextCursor(doc)\n\n    if  self.editor :\n        cursor.insertText(self.editor.toPlainText())\n        cursor.insertBlock()\n\n\n    doc.print_(printer)\n    ",
