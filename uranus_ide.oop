        {
            "item_id": "1d84d9",
            "created_at": "Thursday | 18 June 2026 | 12:24:41",
            "author": "Unknown",
            "item_lock": false,
            "item_type": "Method",
            "title": "variable_table",
            "revision": "1.0",
            "item_tag": "",
            "docstring": "",
            "code": "def variable_table(self, refresh=False):\n        \n    new_data = self.ipython_kernel.inspect_all_user_attributes(self.ipython_kernel.shell)\n    \n    if not new_data  :\n        self.status_c(\" No Data For Showing In Table \" )\n        return\n\n    if hasattr(self, 'obj_table_window') and self.obj_table_window.isVisible() and refresh:\n            \n            \n        self.obj_table_window.add_objects(new_data)\n    elif not refresh:\n            \n        self.obj_table_window = ObjectInspectorWindow(file_name=self.name_only)\n        self.obj_table_window.add_objects(new_data)\n            ",
            "todo_list": [],
            "parent_id": "9fee50",
            "path": "/9fee50/1d84d9",
            "item_suppress": false,
            "item_modifire": "",
