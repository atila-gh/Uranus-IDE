        {
            "item_id": "013a66",
            "created_at": "Thursday | 18 June 2026 | 12:12:45",
            "author": "Unknown",
            "item_lock": false,
            "item_type": "Method",
            "title": "_update_status",
            "revision": "1.0",
            "item_tag": "",
            "docstring": "",
            "code": "\ndef _update_status(self):\n    if self.matches and self.current_index >= 0:\n        self.status_label.setText(f\"Match {self.current_index + 1} of {len(self.matches)}\")\n    else:\n        self.status_label.setText(\"No matches\")\n",
