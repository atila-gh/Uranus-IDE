            "item_lock": false,
            "item_type": "Method",
            "title": "selected_image_format",
            "revision": "1.0",
            "item_tag": "",
            "docstring": "Returns the QTextImageFormat of the image under the current cursor, if any.",
            "code": "def selected_image_format(self):\n    # print('[DocumentEditor->selected_image_format]')\n    cursor = self.editor.textCursor()\n    char_format = cursor.charFormat()\n    if char_format.isImageFormat():\n        return char_format.toImageFormat()\n    return None\n",
