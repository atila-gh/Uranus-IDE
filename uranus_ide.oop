            "revision": "1.0",
            "item_tag": "",
            "docstring": "",
            "code": "def run_cell_blocking(self, cell):\n    loop = QEventLoop()\n\n    def on_done():\n            \n        loop.quit()\n\n    cell.notify_done = on_done\n    cell.run()\n    loop.exec_()\n    ",
