        {
            "item_id": "9495f3",
            "created_at": "Thursday | 18 June 2026 | 12:24:40",
            "author": "Unknown",
            "item_lock": false,
            "item_type": "Method",
            "title": "save_as_file",
            "revision": "1.0",
            "item_tag": "",
            "docstring": "Prompts the user to choose a new file path and saves the notebook content there.\nUpdates self.file_path and status bar message.",
            "code": "def save_as_file(self):\n        \n\n    new_path, _ = QFileDialog.getSaveFileName(\n        self,\n        \"Save As\",\n        self.file_path or \"\",\n        \"Jupyter Notebook (*.ipynb)\"\n    )\n\n    if not new_path:\n        return  # \u06a9\u0627\u0631\u0628\u0631 \u0644\u063a\u0648 \u06a9\u0631\u062f\u0647\n\n    cells = []\n    for cell in self.cell_widgets:\n        if cell.editor_type == \"code\":\n            cells.append(cell.get_nb_code_cell())\n        elif cell.editor_type == \"doc_editor\":\n            cells.append(cell.get_nb_doc_editor_cell())\n\n    nb = nbformat.v4.new_notebook()\n    nb[\"cells\"] = cells\n\n    try:\n        with open(new_path, \"w\", encoding=\"utf-8\") as f:\n            nbformat.write(nb, f)\n    except Exception as e:\n        QMessageBox.warning(self, \"Save Error\", f\"Could not save file:\\n{e}\")\n    else:\n        self.file_path = new_path\n        self.status_l(\"Saved As: \" + new_path)\n",
            "todo_list": [],
            "parent_id": "9fee50",
            "path": "/9fee50/9495f3",
            "item_suppress": false,
            "item_modifire": "",
            "line": 1281,
            "module_id": "57209a",
            "g_flag": false,
