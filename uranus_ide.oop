        },
        {
            "item_id": "66a5ef",
            "created_at": "Thursday | 18 June 2026 | 12:24:42",
            "author": "Unknown",
            "item_lock": false,
            "item_type": "Method",
            "title": "_handle_detached_close_event",
            "revision": "1.0",
            "item_tag": "",
            "docstring": "Custom closeEvent for detached QMainWindow.\nThis ensures WorkWindow's closeEvent logic is triggered.",
            "code": "def _handle_detached_close_event(self, event):\n    self.closeEvent(event)  # \u0627\u062c\u0631\u0627\u06cc \u0645\u0646\u0637\u0642 \u0630\u062e\u06cc\u0631\u0647\u200c\u0633\u0627\u0632\u06cc \u0648 \u0647\u0634\u062f\u0627\u0631\n    if event.isAccepted():\n        self.detached_window = None\n        self.detached = False\n            ",
            "todo_list": [],
            "parent_id": "9fee50",
            "path": "/9fee50/66a5ef",
            "item_suppress": false,
            "item_modifire": "protect",
