        {
            "item_id": "8c419e",
            "created_at": "Saturday | 15 August 2026 | 11:07:28",
            "author": "Unknown",
            "item_lock": false,
            "item_type": "Method",
            "title": "highlightBlock",
            "revision": "1.0",
            "item_tag": "",
            "docstring": "",
            "code": "def highlightBlock(self, text):\n    match = self.line_regex.match(text)\n    if match:\n        start, end = match.span()\n        self.setFormat(start, end - start, self.line_number_format)\n\n    if \"F\" in text or \"E\" in text:\n        self.setFormat(0, len(text), self.error_format)\n    elif \"W\" in text:\n        self.setFormat(0, len(text), self.warning_format)\n    elif \"All checks passed\" in text or \"Clean\" in text:\n        self.setFormat(0, len(text), self.success_format)\n",
            "todo_list": [],
            "parent_id": "66a8db",
            "path": "/66a8db/8c419e",
            "item_suppress": false,
            "item_modifire": "",
