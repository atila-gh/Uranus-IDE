            "docstring": "",
            "code": "\ndef __init__(self, parent=None):\n    super().__init__(parent)\n    self._prompt = \"\"\n    self._value = \"\"\n    self._dialog_parent = parent  # \u0645\u0639\u0645\u0648\u0644\u0627\u064b self \u0627\u0632 MainWindow\n",
