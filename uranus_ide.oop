            "item_tag": "",
            "docstring": "",
            "code": "\ndef goto_prev(self):\n    if not self.matches:\n        self.status_label.setText(\"No matches\")\n        return\n    self.current_index = (self.current_index - 1) % len(self.matches)\n    self._select_match(self.current_index)\n    self._update_status()\n",
