            "code": "def __init__(self):\n    cfg = Config()\n    cfg.InteractiveShellEmbed = Config()\n    cfg.InteractiveShellEmbed.user_ns = {}\n\n\n    self.shell = InteractiveShell(config=cfg)\n    self.input_waiter = InputWaiter()\n    self.object_store = {}\n",
