        {
            "item_id": "6c74ea",
            "created_at": "Thursday | 18 June 2026 | 12:42:27",
            "author": "Unknown",
            "item_lock": false,
            "item_type": "Method",
            "title": "init_syntax_tab",
            "revision": "1.0",
            "item_tag": "",
            "docstring": "",
            "code": "def init_syntax_tab(self):\n    layout = QVBoxLayout()\n    layout.setSpacing(6)\n\n    self.syntax_color_previews = {}\n    for key in self.settings[\"colors_syntax\"]:\n        row = QHBoxLayout()\n        row.setSpacing(6)\n        label = QLabel(f\"{key}:\")\n        preview = QFrame()\n        preview.setFixedSize(60, 22)\n        preview.setStyleSheet(\n            f\"background-color: {self.settings['colors_syntax'][key]}; border: 1px solid gray;\"\n        )\n        preview.setCursor(Qt.PointingHandCursor)\n        preview.mousePressEvent = lambda event, k=key: self.select_color(k)\n        row.addWidget(label)\n        row.addWidget(preview)\n        layout.addLayout(row)\n        self.syntax_color_previews[key] = preview\n\n    self.tab_extra.setLayout(layout)\n",
