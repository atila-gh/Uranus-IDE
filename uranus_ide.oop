            "comment": "",
            "icon_text": "m"
        },
        {
            "item_id": "e23aed",
            "created_at": "Thursday | 18 June 2026 | 12:24:42",
            "author": "Unknown",
            "item_lock": false,
            "item_type": "Method",
            "title": "clear_memory",
            "revision": "1.0",
            "item_tag": "",
            "docstring": "Clear all user-defined variables from the IPython kernel memory.\nKeeps builtins and special variables intact.",
            "code": "def clear_memory(self):\n\n    try:\n        if self.ipython_kernel and self.ipython_kernel.shell:\n            self.ipython_kernel.shell.user_ns.clear()\n            self.ipython_kernel.shell.init_user_ns()\n            print(\"[WorkWindow] IPython memory cleared.\")\n    except Exception as e:\n        print(\"[WorkWindow] Error clearing memory:\", e)\n                ",
