            "item_tag": "",
            "docstring": "",
            "code": "def data(self, index, role=Qt.DisplayRole):\n    if not index.isValid():\n        return None\n    if role == Qt.DisplayRole:\n        value = self._df.iloc[index.row(), index.column()]\n        return str(value)\n    return None\n",
