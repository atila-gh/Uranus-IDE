            "revision": "1.0",
            "item_tag": "",
            "docstring": "",
            "code": "def line_index_to_offset(self, lines, line_num, char_index):\n    res = sum(len(lines[i]) + 1 for i in range(line_num)) + char_index\n    return res\n",
