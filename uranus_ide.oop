        {
            "item_id": "a90658",
            "created_at": "Thursday | 18 June 2026 | 12:12:44",
            "author": "Unknown",
            "item_lock": false,
            "item_type": "Method",
            "title": "replace_all",
            "revision": "1.0",
            "item_tag": "",
            "docstring": "",
            "code": "\ndef replace_all(self):\n    if not self.matches:\n        self.status_label.setText(\"No matches\")\n        return\n    self.replace_text = self.replace_input.text()\n\n    # replace from end to start to avoid shifting positions\n    doc = self.editor.document()\n    cursor = QTextCursor(doc)\n    cursor.beginEditBlock()\n    try:\n        for start, length in reversed(self.matches):\n            c = QTextCursor(doc)\n            c.setPosition(start)\n            c.setPosition(start + length, QTextCursor.KeepAnchor)\n            c.insertText(self.replace_text)\n    finally:\n        cursor.endEditBlock()\n\n    count = len(self.matches)\n    self.matches.clear()\n    self.current_index = -1\n    self.status_label.setText(f\"Replaced {count} matches\")\n",
