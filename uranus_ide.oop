        },
        {
            "item_id": "cac7ae",
            "created_at": "Thursday | 18 June 2026 | 13:39:11",
            "author": "Unknown",
            "item_lock": false,
            "item_type": "Method",
            "title": "apply_direction_to_selection",
            "revision": "1.0",
            "item_tag": "",
            "docstring": "",
            "code": "def apply_direction_to_selection(self, direction: Qt.LayoutDirection):\n    cursor = self.editor.textCursor()\n\n    if not cursor.hasSelection():\n        block = cursor.block()\n        temp_cursor = QTextCursor(block)\n        block_format = temp_cursor.blockFormat()\n        block_format.setLayoutDirection(direction)\n        temp_cursor.mergeBlockFormat(block_format)\n        return\n\n    start = min(cursor.selectionStart(), cursor.selectionEnd())\n    end = max(cursor.selectionStart(), cursor.selectionEnd())\n\n    doc = self.editor.document()\n    block = doc.findBlock(start)\n    end_block = doc.findBlock(end)\n\n    while block.isValid() and block.position() <= end_block.position():\n        temp_cursor = QTextCursor(block)\n        block_format = temp_cursor.blockFormat()\n        block_format.setLayoutDirection(direction)\n        temp_cursor.mergeBlockFormat(block_format)\n        block = block.next()\n    ",
            "todo_list": [],
            "parent_id": "214e95",
