   "source": [
    "def fibo(n):\n",
    "    if n == 0 :        \n",
    "        return 0\n",
    "    if n == 1 :\n",
    "        return 1     \n",
    "    return fibo(n-1) + fibo(n-2) \n",
    "\n",
    "fibo(6)\n"
   ]
  },
