   "source": [
    "lst = []\n",
    "def binn(n):\n",
    "    if n == 0 :\n",
    "        return '0' \n",
    "\n",
    "    if n == 1 :\n",
    "        return '1'\n",
    "        \n",
    "    x = binn(n//2) + str(n%2)\n",
    "    lst.append(x)    \n",
    "    return  x\n",
    "        \n",
    "binn(10005)\n",
    "print(lst)"
   ]
  }
