   "source": [
    "def fact(n):\n",
    "    if n == 0 :      \n",
    "        return 1 \n",
    "    x = n * fact(n-1) \n",
    "    print(n , x)  \n",
    "    return x\n",
    "\n",
    "res = fact(20)\n",
    "res"
   ]
  },
