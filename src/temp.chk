    "\n",
    "def rev(s):    \n",
    "    if len(s) == 0  :  \n",
    "        return ''\n",
    "    \n",
    "    return rev(s[1:]) + s[0]\n",
    "\n",
    "rev('salam')\n"
   ]
  },
